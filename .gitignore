# in Docker, or if the datasets/models become too large for Git.
*.joblib
*.pkl
*.h5

# Ignore the raw dataset if it is large (optional, but good practice)
*.csv
!dataset.csv  # (Uncomment this if you DO want to commit a small sample dataset)

